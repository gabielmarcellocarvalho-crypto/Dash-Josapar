# ============================================================
# Dashboard Josapar — GA4 + Google Ads + Meta  |  Copie para .env.local e preencha
# ============================================================

# --- Google Analytics 4 (Service Account) ---
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GA4_PROJECT_ID=

# --- Propriedades GA4 por marca/site (uma property = um site GA4) ---
GA4_PROPERTY_ID_FEIJAO_TIO_JOAO=
GA4_PROPERTY_ID_JOSAPAR_SITE=
GA4_PROPERTY_ID_TIO_JOAO=
GA4_PROPERTY_ID_ARMAZEM=

# TODO: demais marcas (SupraSoy, Nova Oliva, Meu Biju) ainda sem property GA4 configurada

# --- Google Ads (conta filha dentro de um MCC) ---
# Developer Token: Google Ads API Center da conta MCC
GOOGLE_ADS_DEVELOPER_TOKEN=
# Client ID / Secret: OAuth2 (Google Cloud Console > Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh Token: gerado uma vez via OAuth2 Playground/fluxo de instalação
GOOGLE_ADS_REFRESH_TOKEN=
# Customer ID: conta de anúncios filha (só números, sem hífen, ex: 1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# Login Customer ID: ID da conta MCC (gerenciadora) — obrigatório por a conta acima estar dentro de um MCC
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta App (compartilhado pelos 2 tokens abaixo) ---
# App ID / App Secret: painel do app em developers.facebook.com > Configurações básicas
META_APP_ID=
META_APP_SECRET=

# --- Token 1 — Marketing API (mídia paga Meta/Instagram Ads) ---
# Gerar no Graph API Explorer com a permissão: ads_read
# Trocar pelo de 60 dias: GET https://graph.facebook.com/v21.0/oauth/access_token?grant_type=fb_exchange_token&client_id={META_APP_ID}&client_secret={META_APP_SECRET}&fb_exchange_token={token_curto}
META_ADS_ACCESS_TOKEN=
# Ad Account ID: formato act_XXXXXXXXXXXX (painel do Gerenciador de Anúncios)
META_AD_ACCOUNT_ID=
# Business Manager ID (opcional, útil se a conta de anúncio estiver dentro de um BM)
META_BUSINESS_ID=

# --- Windsor.ai — Instagram orgânico (aba Social Media do dash) ---
# API key: painel do Windsor.ai (app.windsor.ai) > Connectors > API Key
# Endpoint: https://connectors.windsor.ai/instagram?api_key={key}&date_preset=last_30d&fields=...&select_accounts={account_id}
WINDSOR_API_KEY=

# account_id de cada Instagram Business (retornado pelo próprio Windsor via campo account_name)
WINDSOR_ACCOUNT_ID_JOSAPAR=
WINDSOR_ACCOUNT_ID_TIOJOAO=
WINDSOR_ACCOUNT_ID_SUPRASOY=
WINDSOR_ACCOUNT_ID_MEUBIJU=

# TODO: Nova Oliva e Armazém Tio João ainda sem conta de Instagram própria identificada
